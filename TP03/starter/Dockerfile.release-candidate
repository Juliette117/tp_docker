# Reconstruction de shopapi:1.4.2 depuis les sources du TP01.
# Contexte de build : ../TP01/starter/shopapi (depuis TP03).
FROM node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS test
COPY src ./src
COPY test ./test
RUN npm test && npm run lint

FROM test AS production-dependencies
RUN npm prune --omit=dev

FROM node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/corepack
ARG APP_VERSION=1.4.2
ARG GIT_SHA
LABEL org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.source="https://github.com/Juliette117/tp_docker"
ENV NODE_ENV=production APP_VERSION=${APP_VERSION}
WORKDIR /app
COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=test --chown=node:node /app/src ./src
COPY --chown=node:node package.json ./
USER 1000:1000
EXPOSE 3000
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 \
    CMD ["node", "-e", "const http = require('node:http'); const req = http.get('http://127.0.0.1:3000/health', res => { res.resume(); process.exit(res.statusCode === 200 ? 0 : 1); }); req.setTimeout(2000, () => req.destroy()); req.on('error', () => process.exit(1));"]
CMD ["node", "src/server.js"]
